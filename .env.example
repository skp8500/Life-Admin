# ─── Database (required) ─────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/digital_life_dev

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Strong random string used to sign JWTs (e.g. openssl rand -hex 32)
SESSION_SECRET=replace-with-a-strong-random-secret

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS / CSRF ─────────────────────────────────────────────────────────────
# These tell the backend to trust requests from the Vite dev server
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Leave commented out to disable Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
